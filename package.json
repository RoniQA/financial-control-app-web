{
  "name": "nova-agro",
  "version": "1.0.0",
  "description": "Sistema web frontend-only com persistencia local",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "cd apps/frontend && npm run dev",
    "start:dev": "cd apps/frontend && npm run dev",
    "start": "cd apps/frontend && npm run dev",
    "start:frontend": "cd apps/frontend && npm run dev",
    "build": "cd apps/frontend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "preview": "cd apps/frontend && npm run preview",
    "test": "cd apps/frontend && npm run test",
    "test:frontend": "cd apps/frontend && npm run test",
    "lint": "cd apps/frontend && npm run lint",
    "lint:frontend": "cd apps/frontend && npm run lint",
    "format:frontend": "cd apps/frontend && npm run lint -- --fix"
  }
}
